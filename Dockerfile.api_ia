# -------------------------------------------------------
# Base image: Python slim (lightweight, no CUDA)
FROM python:3.10-slim

# -------------------------------------------------------
# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# -------------------------------------------------------
# Set working directory
WORKDIR /app

# -------------------------------------------------------
# Install OS-level dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libgl1-mesa-glx \
    curl \
    gnupg \
    libmagic1 \
    && curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add - \
    && curl https://packages.microsoft.com/config/debian/11/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------
# Copy and install Python dependencies
COPY src/api_ia/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# -------------------------------------------------------
# Create non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# -------------------------------------------------------
# Copy API source code
COPY --chown=appuser:appuser src/api_ia /app/api_ia

# Copy shared models code
COPY --chown=appuser:appuser src/models /app/models

# (Optional) Copy weights if they exist
COPY --chown=appuser:appuser src/api_ia/weights /app/api_ia/weights

# -------------------------------------------------------
# Expose port
EXPOSE 8000

# -------------------------------------------------------
# Command to run the API
CMD ["uvicorn", "api_ia.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
