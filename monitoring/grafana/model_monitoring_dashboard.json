{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "id": 1,
  "title": "EngraveDetect - Monitoring Modèle IA",
  "tags": ["engravedetect","ai","monitoring"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [

    {
      "id": 1,
      "title": "Top-1 Accuracy",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(model_accuracy_correct_total{model_name=\"engravedetect_efficientnet\",k=\"1\"}[5m])) / sum(rate(model_accuracy_predictions_total{model_name=\"engravedetect_efficientnet\",k=\"1\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    },

    {
      "id": 2,
      "title": "Top-3 Accuracy",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(model_accuracy_correct_total{model_name=\"engravedetect_efficientnet\",k=\"3\"}[5m])) / sum(rate(model_accuracy_predictions_total{model_name=\"engravedetect_efficientnet\",k=\"3\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "title": "Distribution des Confiances",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(model_prediction_confidence_bucket{model_name=\"engravedetect_efficientnet\"}[5m])",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },

    {
      "id": 4,
      "title": "Ambiguïté (margin top1-top2)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(model_prediction_top1_margin_bucket{model_name=\"engravedetect_efficientnet\"}[5m])",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Prédictions Ambiguës (<0.05)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(model_ambiguous_predictions_total{model_name=\"engravedetect_efficientnet\",threshold=\"0.05\"}[1h]))",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Latence d'Inférence (P95/P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(model_inference_latency_seconds_bucket{model_name=\"engravedetect_efficientnet\"}[5m])))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(model_inference_latency_seconds_bucket{model_name=\"engravedetect_efficientnet\"}[5m])))",
          "legendFormat": "P99",
          "refId": "B"
        }
      ]
    },

    {
      "id": 7,
      "title": "Drift Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "model_drift_score{model_name=\"engravedetect_efficientnet\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          }
        }
      }
    },

    {
      "id": 8,
      "title": "Statut Drift",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "model_drift_status{model_name=\"engravedetect_efficientnet\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": 1, "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "Warn", "color": "orange" }, "2": { "text": "Alert", "color": "red" } } }
          ]
        }
      }
    },

    {
      "id": 9,
      "title": "Distribution des Classes Prédites",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(model_predicted_classes_total{model_name=\"engravedetect_efficientnet\"}[5m])",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Inputs - Luminosité",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(model_input_brightness_bucket{model_name=\"engravedetect_efficientnet\"}[5m])",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 11,
      "title": "Inputs - Taille Images",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(model_input_width_px_bucket{model_name=\"engravedetect_efficientnet\"}[5m])", "legendFormat": "Largeur {{le}}", "refId": "A" },
        { "expr": "rate(model_input_height_px_bucket{model_name=\"engravedetect_efficientnet\"}[5m])", "legendFormat": "Hauteur {{le}}", "refId": "B" }
      ]
    },

    {
      "id": 12,
      "title": "Inputs - Payload Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(model_request_payload_bytes_bucket{model_name=\"engravedetect_efficientnet\"}[5m])",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    }

  ]
}
